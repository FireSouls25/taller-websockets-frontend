{
  "name": "taller-websockets-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "mock-server"
  ],
  "scripts": {
    "dev:mock": "npm run dev -w mock-server",
    "dev:public": "npm run dev -w apps-public",
    "dev:jurado": "npm run dev -w apps-jurado",
    "dev:consola": "npm run dev -w apps-consola",
    "dev:ops": "npm run dev -w apps-ops",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "echo \"lint pendiente: usar tsc --noEmit por paquete\" && npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
